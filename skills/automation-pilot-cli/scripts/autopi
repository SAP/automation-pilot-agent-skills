#!/bin/sh
# Platform selector for the autopi CLI. Detects the OS/arch and execs the matching
# prebuilt static binary bundled next to this script. No build or network needed.
set -eu

DIR="$(cd "$(dirname "$0")" && pwd)"

os="$(uname -s)"
case "$os" in
  Darwin) os="darwin" ;;
  Linux)  os="linux" ;;
  *) echo "autopi: unsupported OS '$os' (expected Darwin or Linux; on Windows use autopi.cmd)" >&2; exit 1 ;;
esac

arch="$(uname -m)"
case "$arch" in
  x86_64|amd64) arch="amd64" ;;
  arm64|aarch64) arch="arm64" ;;
  *) echo "autopi: unsupported architecture '$arch'" >&2; exit 1 ;;
esac

bin="$DIR/bin/${os}-${arch}/autopi"
if [ ! -x "$bin" ]; then
  echo "autopi: no prebuilt binary for ${os}-${arch} at $bin" >&2
  echo "        rebuild with cli/build.sh (needs a Go toolchain)" >&2
  exit 1
fi

exec "$bin" "$@"
