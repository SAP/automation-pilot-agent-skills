  "negative": [
    {
      "id": "lint-bad-catalog",
      "source": "core.catalog.json",
      "patch": {
        "technicalName": "prefix-too-long"
      },
      "expectedExit": 6,
      "findingContains": "catalog technicalName must contain 1-10"
    },
    {
      "id": "lint-bad-retry",
      "source": "HttpControl.command.json",
      "edit": "retry-enum",
      "expectedExit": 6,
      "findingContains": "retry logic must be FIXED or INCREMENTAL"
    },
    {
      "id": "lint-bad-wire",
      "source": "CollectionPolicy.input.json",
      "edit": "wire-number",
      "expectedExit": 6,
      "findingContains": "wire value must be a JSON string"
    },
    {
      "id": "lint-reserved-tag",
      "source": "FetchPost.command.json",
      "edit": "service-tag",
      "expectedExit": 6,
      "findingContains": "reserved autopi: service prefix"
    },
    {
      "id": "mcp-overlap",
      "source": "public.mcp.json",
      "edit": "binding-overlap",
      "expectedExit": 6,
      "findingContains": "overlapping Input bindings"
    },
    {
      "id": "mcp-unbound-secret",
      "source": "control.mcp.json",
      "edit": "unbound-secret",
      "expectedExit": 6,
      "findingContains": "bind sensitive caller key through a reusable Input"
    }
  ],
  "mcpLifecycle": true,
  "schedule": true,
  "contractExpected": {
    "public": {
      "enrich_post": [
        "postId"
      ],
      "report_portfolio": [
        "postIds"
      ],
      "compare_posts": [
        "firstId",
        "secondId"
      ],
      "get_post_with_fallback": [
        "requestedId"
      ]
    },
    "control": {
      "validate_items": [
        "items"
      ],
      "probe_binding": [],
      "exercise_http_control": [
        "flag",
        "mode"
      ]
    }
  }
}
