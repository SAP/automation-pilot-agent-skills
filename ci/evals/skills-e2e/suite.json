        "<CORE>:EvalApiConfiguration:1",
        "<OPS>:EvalCollectionPolicy:1"
      ],
      "status": "FAILED",
      "assertions": [],
      "failedExecutor": "checkIds"
    },
    {
      "id": "compare-same",
      "command": "<CORE>:ComparePosts:1",
      "values": {
        "firstId": "1",
        "secondId": "2"
      },
      "references": [
        "<CORE>:EvalApiConfiguration:1"
      ],
      "status": "FINISHED",
      "assertions": [
        {
          "path": "summary.sameAuthor",
          "eq": true
        },
        {
          "path": "summary.users",
          "length": 2
        }
      ]
    },
    {
      "id": "compare-different",
      "command": "<CORE>:ComparePosts:1",
