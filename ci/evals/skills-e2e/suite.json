      ],
      "status": "FINISHED",
      "assertions": [
        {
          "path": "summary.sameAuthor",
          "eq": false
        },
        {
          "path": "summary.users",
          "length": 2
        }
      ]
    },
    {
      "id": "fallback-primary",
      "command": "<CORE>:GetPostWithFallback:1",
      "values": {
        "requestedId": "1"
      },
      "references": [
        "<CORE>:EvalApiConfiguration:1"
      ],
      "status": "FINISHED",
      "assertions": [
        {
          "path": "summary.source",
          "eq": "primary"
