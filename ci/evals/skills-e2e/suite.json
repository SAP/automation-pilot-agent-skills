  "cases": [
    {
      "id": "enrich-one",
      "command": "<CORE>:EnrichPost:1",
      "values": {
        "postId": "1"
      },
      "references": [
        "<CORE>:EvalApiConfiguration:1"
      ],
      "status": "FINISHED",
      "assertions": [
        {
          "path": "summary.postId",
          "eq": 1
        },
        {
          "path": "summary.userId",
          "eq": 1
        },
        {
          "path": "summary.author",
          "nonempty": true
        }
      ]
    },
    {
      "id": "portfolio-three",
      "command": "<CORE>:PortfolioReport:1",
      "values": {
        "postIds": "[1,11,21]"
      },
      "references": [
        "<CORE>:EvalApiConfiguration:1",
        "<OPS>:EvalCollectionPolicy:1"
      ],
      "status": "FINISHED",
      "assertions": [
        {
          "path": "summary.count",
          "eq": 3
        },
        {
          "path": "summary.posts",
          "length": 3
        },
        {
          "path": "summary.executions",
          "length": 3
        },
        {
          "path": "summary.posts.0.postId",
          "eq": 1
        },
        {
          "path": "summary.posts.1.postId",
          "eq": 11
        },
        {
          "path": "summary.posts.2.postId",
          "eq": 21
        }
      ],
      "children": 3
    },
    {
      "id": "portfolio-empty",
      "command": "<CORE>:PortfolioReport:1",
      "values": {
        "postIds": "[]"
      },
      "references": [
        "<CORE>:EvalApiConfiguration:1",
        "<OPS>:EvalCollectionPolicy:1"
      ],
      "status": "FINISHED",
      "assertions": [
        {
          "path": "summary.count",
          "eq": 0
        },
        {
          "path": "summary.posts",
          "length": 0
        },
        {
          "path": "summary.executions",
          "length": 0
        }
      ],
      "skipped": "enrichPosts"
    },
    {
