    {
      "id": "http-retrySuccess",
      "command": "<OPS>:HttpControl:1",
      "values": {
        "mode": "retrySuccess"
      },
      "references": [
        "<OPS>:EvalHttpFixtures:1"
      ],
      "status": "FINISHED",
      "assertions": [
        {
          "path": "summary.retryStatus",
          "eq": "200"
        },
        {
          "path": "summary.retryCount",
          "eq": 1
        },
        {
          "path": "summary.expressions.ratio",
          "eq": 3.5
        },
        {
          "path": "summary.expressions.falsePreserved",
          "eq": false
        }
      ],
      "listener": true
    },
    {
      "id": "http-retryExhausted",
      "command": "<OPS>:HttpControl:1",
      "values": {
        "mode": "retryExhausted"
      },
      "references": [
        "<OPS>:EvalHttpFixtures:1"
      ],
      "status": "FAILED",
      "assertions": [],
      "listener": true,
      "failedExecutor": "retryProbe"
    },
    {
      "id": "http-retryPermanent",
      "command": "<OPS>:HttpControl:1",
      "values": {
