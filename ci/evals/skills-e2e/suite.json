      "status": "FINISHED",
      "assertions": [
        {
          "path": "summary.expressions.ratio",
          "eq": 3.5
        },
        {
          "path": "summary.expressions.emptySum",
          "eq": 0
        },
        {
          "path": "summary.expressions.falsePreserved",
          "eq": false
        },
        {
          "path": "summary.pollStatus",
          "eq": "200"
        }
      ],
      "listener": true
    },
