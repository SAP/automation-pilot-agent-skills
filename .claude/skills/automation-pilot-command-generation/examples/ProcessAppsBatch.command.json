{
  "id": "examples-<<<TENANT_ID>>>:ProcessAppsBatch:1",
  "catalog": "examples-<<<TENANT_ID>>>",
  "name": "ProcessAppsBatch",
  "description": "Example: Batch processing with ForEach - list apps and process each",
  "version": 1,
  "inputKeys": {
    "region": {
      "type": "string",
      "required": true,
      "description": "Cloud Foundry region",
      "allowedValuesFromInputKeys": ["metadata-sapcp:CfRegionData:1"]
    },
    "user": {
      "type": "string",
      "required": false,
      "description": "CF user email"
    },
    "password": {
      "type": "string",
      "required": false,
      "sensitive": true,
      "description": "CF user password"
    },
    "refreshToken": {
      "type": "string",
      "required": false,
      "sensitive": true,
      "description": "CF refresh token"
    },
    "spaceId": {
      "type": "string",
      "required": true,
      "description": "Space GUID to list apps from"
    },
    "appStateFilter": {
      "type": "string",
      "required": false,
      "defaultValue": "STARTED",
      "description": "Filter apps by state (STARTED, STOPPED, or empty for all)"
    },
    "batchSize": {
      "type": "number",
      "required": false,
      "defaultValue": "5",
      "minValue": 1,
      "maxValue": 10,
      "description": "Number of apps to process in parallel"
    }
  },
  "outputKeys": {
    "totalApps": {
      "type": "number",
      "description": "Total number of apps found"
    },
    "processedCount": {
      "type": "number",
      "description": "Number of apps processed"
    },
    "results": {
      "type": "array",
      "description": "Processing results for each app"
    }
  },
  "configuration": {
    "values": [
      {
        "alias": "regionData",
        "valueFrom": {
          "inputReference": "metadata-sapcp:CfRegionData:1",
          "inputKey": "$(.execution.input.region)"
        }
      }
    ],
    "output": {
      "totalApps": "$(.listApps.output.body | toObject.pagination.total_results)",
      "processedCount": "$(.processApps.output.outputs | length)",
      "results": "$(.processApps.output.outputs)"
    },
    "executors": [
      {
        "execute": "http-sapcp:HttpRequest:1",
        "alias": "listApps",
        "input": {
          "url": "$(.regionData.cfApiUrl)/v3/apps?space_guids=$(.execution.input.spaceId | toUrlEncoded)$(if .execution.input.appStateFilter != \"\" then \"&states=\" + .execution.input.appStateFilter else \"\" end)",
          "method": "GET",
          "headers": "{\"Accept\": \"application/json\"}",
          "user": "$(.execution.input.user)",
          "password": "$(.execution.input.password)",
          "refreshToken": "$(.execution.input.refreshToken)",
          "tokenUrl": "$(.regionData.uaaTokenUrl)",
          "clientId": "cf",
          "timeout": "30"
        },
        "dryRun": {
          "output": {
            "status": "200",
            "body": "{\"pagination\": {\"total_results\": 2}, \"resources\": [{\"guid\": \"app-1\", \"name\": \"my-app\", \"state\": \"STARTED\"}, {\"guid\": \"app-2\", \"name\": \"other-app\", \"state\": \"STARTED\"}]}",
            "headers": "{\"content-type\": \"application/json\"}",
            "method": "GET",
            "url": "https://api.example.com/v3/apps",
            "time": "200",
            "size": "300"
          }
        },
        "progressMessage": "Listing applications in space...",
        "when": null,
        "validate": {
          "semantic": "OR",
          "conditions": [
            {
              "semantic": "OR",
              "cases": [
                {
                  "expression": "$(.listApps.output.status)",
                  "operator": "EQUALS",
                  "semantic": "OR",
                  "values": ["200"]
                }
              ]
            }
          ]
        },
        "autoRetry": {
          "maxCount": 3,
          "delay": "5s",
          "logic": "INCREMENTAL",
          "when": {
            "semantic": "OR",
            "conditions": [
              {
                "semantic": "OR",
                "cases": [
                  {
                    "expression": "$([408, 429, 500, 502, 503, 504, -1] | filter(. == $.listApps.output.status) | length)",
                    "operator": "EQUALS",
                    "semantic": "OR",
                    "values": ["1"]
                  }
                ]
              }
            ]
          }
        },
        "repeat": null,
        "errorMessages": []
      },
      {
        "execute": "utils-sapcp:Void:1",
        "alias": "prepareInputs",
        "input": {
          "message": "$(.listApps.output.body | toObject.resources | map({appGuid: .guid, appName: .name, appState: .state, region: $.execution.input.region, user: $.execution.input.user, password: $.execution.input.password, refreshToken: $.execution.input.refreshToken}) | toMinifiedJsonString)"
        },
        "dryRun": {
          "output": {
            "message": "[{\"appGuid\":\"app-1\",\"appName\":\"my-app\",\"appState\":\"STARTED\"}]"
          }
        },
        "progressMessage": "Found $(.listApps.output.body | toObject.pagination.total_results) apps to process",
        "when": {
          "semantic": "OR",
          "conditions": [
            {
              "semantic": "OR",
              "cases": [
                {
                  "expression": "$(.listApps.output.body | toObject.pagination.total_results)",
                  "operator": "NOT_EQUALS",
                  "semantic": "OR",
                  "values": ["0"]
                }
              ]
            }
          ]
        },
        "validate": null,
        "autoRetry": null,
        "repeat": null,
        "errorMessages": []
      },
      {
        "execute": "utils-sapcp:ForEach:2",
        "alias": "processApps",
        "input": {
          "command": "examples-<<<TENANT_ID>>>:ProcessSingleApp:1",
          "inputs": "$(.prepareInputs.output.message | toArray)",
          "defaultValues": "{}",
          "batchSize": "$(.execution.input.batchSize)"
        },
        "dryRun": {
          "output": {
            "outputs": "[{\"status\": \"SUCCESS\"}]"
          }
        },
        "progressMessage": "Processing $(.prepareInputs.output.message | toArray | length) apps with batch size $(.execution.input.batchSize)...",
        "when": {
          "semantic": "OR",
          "conditions": [
            {
              "semantic": "OR",
              "cases": [
                {
                  "expression": "$(.listApps.output.body | toObject.pagination.total_results)",
                  "operator": "NOT_EQUALS",
                  "semantic": "OR",
                  "values": ["0"]
                }
              ]
            }
          ]
        },
        "validate": null,
        "autoRetry": null,
        "repeat": null,
        "errorMessages": []
      }
    ],
    "listeners": []
  },
  "tags": {
    "env": "cf"
  }
}
