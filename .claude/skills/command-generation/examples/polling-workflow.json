{
  "id": "examples-<<<TENANT_ID>>>:WaitForOperation:1",
  "catalog": "examples-<<<TENANT_ID>>>",
  "name": "WaitForOperation",
  "description": "Example: Polling pattern - wait for async operation to complete with timeout",
  "version": 1,
  "inputKeys": {
    "region": {
      "type": "string",
      "required": true,
      "description": "Cloud Foundry region",
      "allowedValuesFromInputKeys": ["metadata-sapcp:CfRegionData:1"]
    },
    "user": {
      "type": "string",
      "required": false,
      "description": "CF user email"
    },
    "password": {
      "type": "string",
      "required": false,
      "sensitive": true,
      "description": "CF user password"
    },
    "refreshToken": {
      "type": "string",
      "required": false,
      "sensitive": true,
      "description": "CF refresh token"
    },
    "jobId": {
      "type": "string",
      "required": true,
      "description": "ID of the async job to monitor"
    },
    "timeoutMinutes": {
      "type": "number",
      "required": false,
      "defaultValue": "10",
      "minValue": 1,
      "maxValue": 60,
      "description": "Maximum time to wait (minutes)"
    },
    "pollIntervalSeconds": {
      "type": "number",
      "required": false,
      "defaultValue": "15",
      "minValue": 5,
      "maxValue": 120,
      "description": "Interval between status checks (seconds)"
    }
  },
  "outputKeys": {
    "finalState": {
      "type": "string",
      "description": "Final state of the operation"
    },
    "result": {
      "type": "object",
      "description": "Full job result object"
    }
  },
  "configuration": {
    "values": [
      {
        "alias": "regionData",
        "valueFrom": {
          "inputReference": "metadata-sapcp:CfRegionData:1",
          "inputKey": "$(.execution.input.region)"
        }
      }
    ],
    "output": {
      "finalState": "$(.checkJob.output.body | toObject.state)",
      "result": "$(.checkJob.output.body | toObject)"
    },
    "executors": [
      {
        "execute": "utils-sapcp:Void:1",
        "alias": "recordStartTime",
        "input": {
          "message": "$(now)"
        },
        "progressMessage": "Starting to monitor job $(.execution.input.jobId)",
        "when": null,
        "validate": null,
        "autoRetry": null,
        "repeat": null,
        "errorMessages": []
      },
      {
        "execute": "http-sapcp:HttpRequest:1",
        "alias": "checkJob",
        "input": {
          "url": "$(.regionData.cfApiUrl)/v3/jobs/$(.execution.input.jobId | toUrlEncoded)",
          "method": "GET",
          "headers": "{\"Accept\": \"application/json\"}",
          "user": "$(.execution.input.user)",
          "password": "$(.execution.input.password)",
          "refreshToken": "$(.execution.input.refreshToken)",
          "tokenUrl": "$(.regionData.uaaTokenUrl)",
          "clientId": "cf",
          "timeout": "20"
        },
        "progressMessage": "Job status: $(.checkJob.output.body | toObject.state // \"checking...\") - Elapsed: $(((now - (.recordStartTime.output.message | toNumber)) / 60 * 10 | floor) / 10) minutes",
        "initialDelay": null,
        "pause": null,
        "when": null,
        "validate": {
          "semantic": "OR",
          "conditions": [
            {
              "semantic": "AND",
              "cases": [
                {
                  "expression": "$(.checkJob.output.body | toObject.state)",
                  "operator": "NOT_EQUALS",
                  "semantic": "OR",
                  "values": ["FAILED"]
                },
                {
                  "expression": "$(.execution.input.timeoutMinutes * 60 - (now - (.recordStartTime.output.message | toNumber)) < .execution.input.pollIntervalSeconds)",
                  "operator": "NOT_EQUALS",
                  "semantic": "OR",
                  "values": ["true"]
                }
              ]
            }
          ]
        },
        "autoRetry": {
          "maxCount": 3,
          "delay": "5s",
          "logic": "INCREMENTAL",
          "applyOnValidation": false,
          "when": {
            "semantic": "OR",
            "conditions": [
              {
                "semantic": "OR",
                "cases": [
                  {
                    "expression": "$([408, 429, 500, 502, 503, 504, -1] | filter(. == $.checkJob.output.status) | length)",
                    "operator": "EQUALS",
                    "semantic": "OR",
                    "values": ["1"]
                  }
                ]
              }
            ]
          }
        },
        "repeat": {
          "maxCount": 720,
          "delay": "$(.execution.input.pollIntervalSeconds)s",
          "failOnMaxCount": false,
          "until": {
            "semantic": "OR",
            "conditions": [
              {
                "semantic": "OR",
                "cases": [
                  {
                    "expression": "$(.checkJob.output.body | toObject.state)",
                    "operator": "EQUALS",
                    "semantic": "OR",
                    "values": ["COMPLETE", "SUCCEEDED"]
                  }
                ]
              }
            ]
          }
        },
        "errorMessages": [
          {
            "message": "Job failed: $(.checkJob.output.body | toObject.errors | map(.detail) | join(\", \"))",
            "when": {
              "semantic": "OR",
              "conditions": [
                {
                  "semantic": "OR",
                  "cases": [
                    {
                      "expression": "$(.checkJob.output.body | toObject.state)",
                      "operator": "EQUALS",
                      "semantic": "OR",
                      "values": ["FAILED"]
                    }
                  ]
                }
              ]
            }
          },
          {
            "message": "Timeout exceeded: operation did not complete within $(.execution.input.timeoutMinutes) minutes. Last state: $(.checkJob.output.body | toObject.state)",
            "when": {
              "semantic": "OR",
              "conditions": [
                {
                  "semantic": "AND",
                  "cases": [
                    {
                      "expression": "$(.checkJob.output.body | toObject.state)",
                      "operator": "NOT_EQUALS",
                      "semantic": "OR",
                      "values": ["COMPLETE", "SUCCEEDED"]
                    },
                    {
                      "expression": "$(.execution.input.timeoutMinutes * 60 - (now - (.recordStartTime.output.message | toNumber)) < .execution.input.pollIntervalSeconds)",
                      "operator": "EQUALS",
                      "semantic": "OR",
                      "values": ["true"]
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    ],
    "listeners": []
  },
  "tags": {
    "env": "cf"
  }
}
